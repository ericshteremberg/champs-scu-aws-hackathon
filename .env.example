# Store real values in the hosting secret store, not in source control.
# Leave these unset for an unconnected build with manual and sample cases.
STRIPE_RESTRICTED_KEY=
STRIPE_WORKSPACE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
STRIPE_ENABLE_SUBMISSION=false

# Local Workers read .dev.vars. Copy this file there and fill only required values.
# Hosted builds use the Site runtime secret store. Never use NEXT_PUBLIC_* secrets.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# The merchant grants access to specific cases. Bind this connection to one
# exact Causality workspace ID, available on the Connections screen.
MERCHANT_EVIDENCE_URL=
MERCHANT_EVIDENCE_TOKEN=
MERCHANT_WORKSPACE_ID=

# Optional private archive of an explicitly approved evidence packet.
S3_EVIDENCE_BUCKET=
