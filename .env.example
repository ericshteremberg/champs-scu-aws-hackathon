# Copy to .env. This file contains configuration names only, never credentials.
# Sample mode works without any cloud credentials and is visibly labeled in the UI.
INVESTIGATION_MODE=demo
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.data/casework.sqlite

# The hackathon requires us-east-1. Use temporary Workshop Studio credentials
# through your terminal or an AWS profile. Include AWS_SESSION_TOKEN.
# Never put AWS secrets in VITE_* variables or commit them.
AWS_REGION=us-east-1
# Copy an enabled tool-capable model or inference profile ID from your workshop.
BEDROCK_MODEL_ID=

# Merchant-owned API base, for example https://merchant.example.
# The backend calls {base}/v1/cases/{caseId}/evidence?section=summary.
MERCHANT_EVIDENCE_URL=
MERCHANT_EVIDENCE_TOKEN=

# Optional private S3 bucket for reviewed evidence packets.
S3_EVIDENCE_BUCKET=

# Required before binding a public interface or using NODE_ENV=production.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=
# Set the exact HTTPS origin when deploying behind a proxy.
APP_ORIGIN=

RUN_TIMEOUT_MS=180000
MAX_TOOL_CALLS=16
DEMO_STEP_MS=500
