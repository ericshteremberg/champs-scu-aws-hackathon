{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.blacklabelcreators.causality",
  "name": "Causality",
  "version": "0.1.0",
  "icon": "./icon.png",
  "ui_extension": {},
  "extensions": null,
  "permissions": [
    {
      "permission": "dispute_read",
      "purpose": "Read the selected payment dispute and its evidence requirements for investigation."
    },
    {
      "permission": "charge_read",
      "purpose": "Read the disputed payment and refund history to match payment records to the selected case."
    }
  ],
  "allowed_redirect_uris": [
    "https://causality-hackathon-dev.slidah60.workers.dev/api/providers/stripe/callback"
  ],
  "distribution_type": "public",
  "stripe_api_access_type": "oauth"
}