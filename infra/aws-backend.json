{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Causality AWS hackathon backend: private Lambda, DynamoDB, S3, and Bedrock.",
  "Parameters": {
    "FrontendOrigin": {
      "Type": "String",
      "Default": "https://not-configured.example.invalid"
    },
    "BedrockModelId": {
      "Type": "String",
      "Default": "us.anthropic.claude-opus-5"
    },
    "SupabaseOAuthSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing Secrets Manager app registration, never a client secret value."
    },
    "StripeOAuthSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing Secrets Manager Stripe app registration, never a developer key value."
    },
    "ResendSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing Resend credential ARN; no secret values."
    },
    "ResendWorkspaceId": {
      "Type": "String",
      "Default": "",
      "Description": "Single approved workspace bound to this merchant Resend account."
    },
    "ResendAllowedDomains": {
      "Type": "String",
      "Default": "",
      "Description": "Comma-separated exact sending domains approved for evidence."
    },
    "GmailOAuthSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing Secrets Manager Google OAuth registration ARN, never a client secret."
    }
  },
  "Resources": {
    "WorkspaceTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttlEpochSeconds",
          "Enabled": true
        }
      }
    },
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "FrontendOrigin"
                }
              ],
              "AllowedMethods": [
                "POST",
                "PUT",
                "GET",
                "HEAD"
              ],
              "AllowedHeaders": [
                "*"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 300
            }
          ]
        }
      }
    },
    "EvidenceBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "EvidenceBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "EvidenceBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${EvidenceBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "BackendLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/causality-hackathon-backend",
        "RetentionInDays": 7
      }
    },
    "BackendRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CausalityBackend",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkspaceTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:*::foundation-model/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:*:${AWS::AccountId}:inference-profile/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:causality-hackathon-investigator"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "BackendLogs",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "InvestigatorLogs",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "Fn::If": [
              "HasSupabaseOAuth",
              {
                "PolicyName": "SupabaseOAuthRegistration",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": {
                        "Ref": "SupabaseOAuthSecretArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "HasStripeOAuth",
              {
                "PolicyName": "StripeOAuthRegistration",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": {
                        "Ref": "StripeOAuthSecretArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "HasResend",
              {
                "PolicyName": "ResendEvidenceRead",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": [
                        "secretsmanager:GetSecretValue"
                      ],
                      "Resource": {
                        "Ref": "ResendSecretArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "HasGmailOAuth",
              {
                "PolicyName": "GmailOAuthRegistration",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "secretsmanager:GetSecretValue",
                      "Resource": {
                        "Ref": "GmailOAuthSecretArn"
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "BackendFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "causality-hackathon-backend",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 180,
        "ReservedConcurrentExecutions": 5,
        "Role": {
          "Fn::GetAtt": [
            "BackendRole",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "exports.handler=async()=>({status:503,body:{error:'Backend code deployment is pending.'}});"
        },
        "Environment": {
          "Variables": {
            "CAUSALITY_TABLE": {
              "Ref": "WorkspaceTable"
            },
            "EVIDENCE_BUCKET": {
              "Ref": "EvidenceBucket"
            },
            "BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "FUNCTION_NAME": "causality-hackathon-investigator",
            "SUPABASE_OAUTH_SECRET_ARN": {
              "Ref": "SupabaseOAuthSecretArn"
            },
            "CAUSALITY_FRONTEND_ORIGIN": {
              "Ref": "FrontendOrigin"
            },
            "STRIPE_OAUTH_SECRET_ARN": {
              "Ref": "StripeOAuthSecretArn"
            },
            "RESEND_SECRET_ARN": {
              "Ref": "ResendSecretArn"
            },
            "RESEND_WORKSPACE_ID": {
              "Ref": "ResendWorkspaceId"
            },
            "RESEND_ALLOWED_DOMAINS": {
              "Ref": "ResendAllowedDomains"
            },
            "GMAIL_OAUTH_SECRET_ARN": {
              "Ref": "GmailOAuthSecretArn"
            }
          }
        }
      }
    },
    "AsyncPolicy": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "InvestigatorFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumEventAgeInSeconds": 300,
        "MaximumRetryAttempts": 0
      }
    },
    "InvestigatorFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "causality-hackathon-investigator",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 300,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "BackendRole",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "exports.handler=async()=>({status:503,body:{error:'Backend code deployment is pending.'}});"
        },
        "Environment": {
          "Variables": {
            "CAUSALITY_TABLE": {
              "Ref": "WorkspaceTable"
            },
            "EVIDENCE_BUCKET": {
              "Ref": "EvidenceBucket"
            },
            "BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "FUNCTION_NAME": "causality-hackathon-investigator"
          }
        }
      }
    },
    "InvestigatorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/causality-hackathon-investigator",
        "RetentionInDays": 7
      }
    },
    "ResendWebhookRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasResend",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ResendEvidenceRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "ResendSecretArn"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ResendEventCapture",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkspaceTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        {
                          "Ref": "ResendWorkspaceId"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ResendWebhookFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasResend",
      "Properties": {
        "FunctionName": "causality-resend-webhook",
        "Runtime": "nodejs22.x",
        "Handler": "index.resendWebhookHandler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 20,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "ResendWebhookRole",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "exports.resendWebhookHandler=async()=>({statusCode:503,body:'Setup pending'});"
        },
        "Environment": {
          "Variables": {
            "CAUSALITY_TABLE": {
              "Ref": "WorkspaceTable"
            },
            "RESEND_SECRET_ARN": {
              "Ref": "ResendSecretArn"
            },
            "RESEND_WORKSPACE_ID": {
              "Ref": "ResendWorkspaceId"
            },
            "RESEND_ALLOWED_DOMAINS": {
              "Ref": "ResendAllowedDomains"
            }
          }
        }
      }
    },
    "ResendWebhookUrl": {
      "Type": "AWS::Lambda::Url",
      "Condition": "HasResend",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "ResendWebhookFunction"
        },
        "AuthType": "NONE"
      }
    },
    "ResendWebhookUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasResend",
      "Properties": {
        "FunctionName": {
          "Ref": "ResendWebhookFunction"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ResendWebhookInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasResend",
      "Properties": {
        "FunctionName": {
          "Ref": "ResendWebhookFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "BackendFunction"
      }
    },
    "TableName": {
      "Value": {
        "Ref": "WorkspaceTable"
      }
    },
    "BucketName": {
      "Value": {
        "Ref": "EvidenceBucket"
      }
    },
    "BucketOrigin": {
      "Value": {
        "Fn::Sub": "https://${EvidenceBucket}.s3.${AWS::Region}.amazonaws.com"
      }
    },
    "InvestigatorFunctionName": {
      "Value": {
        "Ref": "InvestigatorFunction"
      }
    },
    "ResendWebhookUrl": {
      "Condition": "HasResend",
      "Value": {
        "Fn::GetAtt": [
          "ResendWebhookUrl",
          "FunctionUrl"
        ]
      }
    }
  },
  "Conditions": {
    "HasSupabaseOAuth": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "SupabaseOAuthSecretArn"
            },
            ""
          ]
        }
      ]
    },
    "HasStripeOAuth": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "StripeOAuthSecretArn"
            },
            ""
          ]
        }
      ]
    },
    "HasResend": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ResendSecretArn"
                },
                ""
              ]
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ResendWorkspaceId"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "HasGmailOAuth": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "GmailOAuthSecretArn"
            },
            ""
          ]
        }
      ]
    }
  }
}
