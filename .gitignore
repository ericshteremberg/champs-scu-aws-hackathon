next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/
/test-results/
/playwright-report/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

